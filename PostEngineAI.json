{
  "name": "Automatizar posts no LinkedIn com IA",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 15
            }
          ]
        }
      },
      "id": "bb953ee3-09ab-485a-87a6-0d7cd98aa0c3",
      "name": "Todo dia às 15h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "databasePage",
        "operation": "getAll",
        "dataSourceId": {
          "__rl": true,
          "value": "c33277df-5718-407e-8ce8-a857f61959d4",
          "mode": "id"
        },
        "limit": 30,
        "options": {
          "sort": {
            "sortValue": [
              {
                "timestamp": true,
                "key": "created_time",
                "direction": "descending"
              }
            ]
          }
        }
      },
      "id": "b7e2f41c-afe4-4556-9235-b6b2e0376bb9",
      "name": "Buscar temas já publicados",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 3,
      "position": [
        272,
        128
      ],
      "alwaysOutputData": true,
      "credentials": {
        "notionOAuth2Api": {
          "id": "W9NpFjgKRWoDhDLX",
          "name": "Notion account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "area",
              "name": "area",
              "type": "string",
              "value": "={{ [\"Desenvolvimento Fullstack\", \"Cibersegurança\", \"Suporte de TI\"][$today.ordinal % 3] }}"
            },
            {
              "id": "temasAnteriores",
              "name": "temasAnteriores",
              "type": "string",
              "value": "={{ $input.all().map(i => i.json.name || i.json.property_name || \"\").filter(t => t && String(t).trim()).map(t => \"- \" + t).join(\"\\n\") || \"(nenhum ainda)\" }}"
            }
          ]
        },
        "options": {}
      },
      "id": "e4958e02-0a65-4329-a98b-ce80c3f10574",
      "name": "Definir área e temas anteriores",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        592,
        128
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "GPT-5-MINI"
        },
        "responses": {
          "values": [
            {
              "content": "=Área do post de hoje: {{ $json.area }}\n\nTemas que já publiquei (NÃO repita nenhum deles nem algo muito parecido):\n{{ $json.temasAnteriores }}\n\nEscolha um tema novo e relevante dentro dessa área e escreva o post de hoje."
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "instructions": "Você escreve posts de LinkedIn em português do Brasil para Leonardo Magalhães, profissional de tecnologia que atua como Desenvolvedor Fullstack, com Cibersegurança e Suporte de TI. Cada post deve ser sobre UM tema prático da área indicada (ex.: boas práticas de código, frameworks, APIs, bancos de dados, segurança de aplicações, phishing, senhas e MFA, LGPD, hardening, backup, troubleshooting, atendimento ao usuário, produtividade em TI). Escreva em primeira pessoa, tom profissional e acessível, compartilhando dicas ou aprendizados úteis. Estrutura: um gancho forte na primeira linha, parágrafos curtos com quebras de linha, uma lista curta de dicas quando fizer sentido, e termine com uma pergunta para engajar e 3 a 5 hashtags relevantes. Entre 600 e 1500 caracteres. Não invente números, estatísticas, empresas ou experiências específicas. Sem markdown (sem ** nem títulos com #). Responda no formato JSON pedido: titulo = tema curto do post (até 80 caracteres); post = texto completo do post; busca_imagem = 2 a 4 palavras EM INGLÊS para buscar uma foto de banco de imagens que ilustre o tema (ex.: cybersecurity laptop, software developer coding, it support helpdesk), sem nomes de marcas.",
          "maxTokens": 4000,
          "reasoning": {
            "reasoningOptions": {
              "effort": "low",
              "summary": "none"
            }
          },
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "post_linkedin",
              "schema": "{\"type\":\"object\",\"properties\":{\"titulo\":{\"type\":\"string\"},\"post\":{\"type\":\"string\"},\"busca_imagem\":{\"type\":\"string\"}},\"required\":[\"titulo\",\"post\",\"busca_imagem\"],\"additionalProperties\":false}",
              "strict": true
            }
          }
        }
      },
      "id": "1d4c9301-0b9c-4260-9a71-b9f372d0312d",
      "name": "Escrever post com IA",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        1168,
        128
      ],
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "url": "https://api.unsplash.com/search/photos",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $json.output.find(o => o.type === \"message\").content.find(c => c.type === \"output_text\").text.busca_imagem }}"
            },
            {
              "name": "per_page",
              "value": "10"
            },
            {
              "name": "orientation",
              "value": "landscape"
            },
            {
              "name": "content_filter",
              "value": "high"
            }
          ]
        },
        "options": {}
      },
      "id": "c249f144-0d01-4014-88d4-ee311dc19085",
      "name": "Buscar foto no Unsplash",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1024,
        128
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "fotoUrl",
              "name": "fotoUrl",
              "type": "string",
              "value": "={{ $json.results[$today.ordinal % $json.results.length].urls.regular }}"
            },
            {
              "id": "fotografo",
              "name": "fotografo",
              "type": "string",
              "value": "={{ $json.results[$today.ordinal % $json.results.length].user.name }}"
            }
          ]
        },
        "options": {}
      },
      "id": "36fcfef1-1592-49e8-a9af-d08138e44942",
      "name": "Escolher foto",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
